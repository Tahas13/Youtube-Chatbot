# Gemini / Google AI Studio
GOOGLE_API_KEY=your-google-ai-studio-api-key
LLM_MODEL=gemini-1.5-flash

# Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=yt-chatbot

# App Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SEMANTIC_CHUNKING=true
RETRIEVAL_K=20
RETRIEVAL_TOP_N=5
MMR_LAMBDA=0.7
MMR_FETCH_K=50
BACKEND_CORS_ORIGINS=chrome-extension://*,http://localhost:5173
SESSION_TTL_SECONDS=3600
SESSION_STORE_BACKEND=auto
REDIS_URL=redis://localhost:6379/0
SESSION_SQLITE_PATH=data/sessions.db
KEYWORD_INDEX_SQLITE_PATH=data/keyword_index.db
EVIDENCE_CONFIDENCE_THRESHOLD=0.5
